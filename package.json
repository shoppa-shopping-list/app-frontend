{
  "name": "shoppa-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier . --check",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "check": "npm run lint && npm run stylelint && npm run format:check && npm run typecheck && npm run api:check && npm run test:ci && npm run build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "build:backend": "npm run build && node scripts/stage-backend.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router": "^7.15.1",
    "motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-dialog": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "postcss-scss": "^4.0.9",
    "prettier": "3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^17.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^27.0.0",
    "@playwright/test": "^1.56.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-config-prettier": "^10.1.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-plugin-playwright": "^2.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.0",
    "tsx": "^4.23.13",
    "@rtk-query/codegen-openapi": "^2.2.0"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
